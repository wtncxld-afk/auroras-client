# Auroras website configuration. Copy to .env.local for development; in production set these as the host's
# environment variables or secrets. Every value below is a placeholder: nothing here is connected to a real service.

# development | production. Production enforces https, database TLS, a signing key and owner MFA.
APP_ENV=development
# Public origin of the site, no trailing slash. Must be https:// in production.
SITE_URL=http://localhost:3000

# PostgreSQL 14+. Production: a managed Postgres with TLS (DATABASE_SSL defaults to "require" in production).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# DATABASE_SSL=require
# DATABASE_POOL_MAX=10

# 32+ random characters (session and rate-limit hashing). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=replace-with-a-long-random-value-placeholder
# 32 random bytes, base64 (encrypts the owner's TOTP secret). Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=REPLACE_WITH_32_RANDOM_BYTES_BASE64=
# SESSION_TTL_HOURS=12
# SESSION_IDLE_MINUTES=120
# Only set to true behind a proxy you control that overwrites X-Forwarded-For (used for rate limiting).
# TRUST_PROXY_HEADERS=false

# File storage: "local" (a directory, for development or a single server with a persistent disk) or "s3"
# (S3, Cloudflare R2, Backblaze B2, MinIO ... anything S3-compatible).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
# S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=auroras-releases
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false
# DOWNLOAD_URL_TTL_SECONDS=300
# MAX_UPLOAD_MB=512
# MAX_IMAGE_MB=5
# Hosts that imported release files may redirect to (comma-separated).
# EXTERNAL_ASSET_HOSTS=github.com

# Ed25519 private key that signs /updates/manifest.json for the launcher (PEM, PEM with \n escapes, or base64 of
# the PEM). Generate with `npm run keys:generate`. Keep it only in your host's secret store; never commit it.
# UPDATE_SIGNING_KEY=
# REQUIRE_SIGNED_MANIFEST=true

# Optional: POST (HMAC-SHA256 signed) to this URL after every public release change.
# RELEASE_WEBHOOK_URL=https://example.invalid/hooks/auroras
# RELEASE_WEBHOOK_SECRET=
# Optional: purge Cloudflare's cache for the public pages after release changes.
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=
