{
  "name": "auroras-website",
  "version": "0.1.0",
  "private": true,
  "description": "Auroras Client website, download platform and owner admin panel",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:seed": "node --conditions=react-server --import tsx scripts/seed.ts",
    "owner:create": "node --conditions=react-server --import tsx scripts/owner.ts create",
    "owner:reset-password": "node --conditions=react-server --import tsx scripts/owner.ts reset-password",
    "owner:reset-mfa": "node --conditions=react-server --import tsx scripts/owner.ts reset-mfa",
    "owner:revoke-sessions": "node --conditions=react-server --import tsx scripts/owner.ts revoke-sessions",
    "ci-token:create": "node --conditions=react-server --import tsx scripts/owner.ts ci-token",
    "keys:generate": "node --import tsx scripts/gen-signing-key.ts",
    "import:github": "node --conditions=react-server --import tsx scripts/import-github-releases.ts",
    "test": "node --conditions=react-server --import tsx --test --test-concurrency=1 tests/unit/*.test.ts",
    "test:api": "node --import tsx --test --test-concurrency=1 tests/api/*.test.ts",
    "test:e2e": "node --import tsx --test --test-concurrency=1 tests/e2e/*.test.ts",
    "test:bundle": "node --import tsx --test tests/bundle/*.test.ts",
    "screenshots": "node --import tsx tests/e2e/screenshots.ts",
    "sync:product-data": "node scripts/sync-product-data.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1140.0",
    "@aws-sdk/s3-request-presigner": "3.1140.0",
    "@fontsource-variable/inter": "5.3.0",
    "@node-rs/argon2": "2.0.2",
    "drizzle-orm": "0.45.3",
    "framer-motion": "12.43.0",
    "lucide-react": "0.542.0",
    "next": "15.5.28",
    "postgres": "3.4.9",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "autoprefixer": "10.4.21",
    "drizzle-kit": "0.31.4",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
